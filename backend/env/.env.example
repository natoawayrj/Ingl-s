# Copie para .env e preencha. NUNCA commite o .env real.
#   copy .env.example .env
#
# ATENCAO A QUEM CLONOU: os valores abaixo apontam para os servicos de IA
# rodando na MINHA maquina (Whisper e LLM locais). Eles nao existem na sua.
# Voce PRECISA editar as secoes de Whisper e LLM para a sua realidade -
# seja subindo os servidores locais, seja apontando para uma API paga.
# Veja a secao "Trocar os motores de IA" no README.

# ----- MySQL -----
# No Docker o compose sobrescreve DB_HOST para "db"; nao precisa mexer aqui.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua-senha-do-mysql
DB_NAME=pronuncia

# ----- Auth -----
# gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-um-hex-aleatorio
JWT_EXPIRE_HOURS=720

# ============================================================
# Whisper (fala -> texto). ESCOLHA UM DOS DOIS.
# ============================================================
# "whispercpp" = servidor local (de graca, audio nao sai da maquina)
# "openai"     = Whisper API da OpenAI (paga, o audio SAI da sua maquina)
WHISPER_PROVIDER=whispercpp

# --- se WHISPER_PROVIDER=whispercpp ---
# Exige o whisper.cpp server rodando. Veja Pre-requisitos no README.
WHISPER_URL=http://127.0.0.1:8080/inference

# --- se WHISPER_PROVIDER=openai ---
OPENAI_API_KEY=sk-...
OPENAI_WHISPER_MODEL=whisper-1

# ============================================================
# LLM (feedback, explicacao fonetica, chat e geracao de frases).
# Qualquer endpoint OpenAI-compatible serve.
# ============================================================
# Padrao: LM Studio local na porta 1234, sem chave.
# Exige o LM Studio com um modelo carregado e o Server ligado.
LLM_URL=http://127.0.0.1:1234/v1/chat/completions
LLM_MODEL=qwen2.5-7b-instruct
LLM_TEMPERATURE=0.3

# Deixe VAZIO para servidor local (LM Studio, Ollama, vLLM nao pedem chave).
# Preencha SO se LLM_URL apontar para uma API paga - ai vai como Bearer token.
#   OpenAI:     LLM_URL=https://api.openai.com/v1/chat/completions
#   Groq:       LLM_URL=https://api.groq.com/openai/v1/chat/completions
#   OpenRouter: LLM_URL=https://openrouter.ai/api/v1/chat/completions
#   Ollama:     LLM_URL=http://127.0.0.1:11434/v1/chat/completions  (sem chave)
LLM_API_KEY=

# Prefira modelo NAO-thinking (ex.: qwen2.5-7b-instruct). Modelo "reasoning"
# gasta o orcamento de tokens pensando: ~8x mais lento e as vezes volta vazio.

# Abaixo deste accuracy (0..1) o LLM gera explicacao fonetica detalhada
EXPLAIN_ACCURACY_THRESHOLD=0.8

# ffmpeg: precisa estar no PATH (no Docker ja vem na imagem)
FFMPEG_BIN=ffmpeg
